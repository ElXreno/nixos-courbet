From d1ff80f6f74208f687ef3217f94e3e5bf9f2d432 Mon Sep 17 00:00:00 2001
From: ElXreno <elxreno@gmail.com>
Date: Sat, 3 Oct 2026 02:29:53 +0300
Subject: [PATCH] hexagonfs: map the panel backlight and display sysfs
 directories

---
 hexagonrpcd/rpcd_builder.c | 25 ++++++++++++++++++++++++-
 1 file changed, 24 insertions(+), 1 deletion(-)

diff --git a/hexagonrpcd/rpcd_builder.c b/hexagonrpcd/rpcd_builder.c
index e238787..1f94022 100644
--- a/hexagonrpcd/rpcd_builder.c
+++ b/hexagonrpcd/rpcd_builder.c
@@ -33,6 +33,8 @@
 #define SNS_REG_VERSION		"/sensors/sns_reg_version"
 #define SNS_REG_CONFIG		"/sensors/sns_reg.conf"
 #define SYSFS_SOCINFO		"/socinfo/"
+#define SYSFS_BACKLIGHT		"/backlight/"
+#define SYSFS_DISPLAY		"/display/"
 
 static struct hexagonfs_dirent *hfs_mkdir(const char *name, size_t n_ents, ...)
 {
@@ -124,6 +126,7 @@ struct hexagonfs_dirent *construct_root_dir(const char *prefix, const char *dsp,
 					    const char *registry_dir)
 {
 	char *acdbdata, *dsp_libs, *sns_cfg, *sns_reg, *sns_reg_version, *sns_reg_config, *socinfo;
+	char *backlight, *display;
 	size_t n_prefix;
 	struct hexagonfs_dirent *persist_dir, *vendor_dir;
 
@@ -135,6 +138,8 @@ struct hexagonfs_dirent *construct_root_dir(const char *prefix, const char *dsp,
 	sns_reg_version = malloc(n_prefix + strlen(SNS_REG_VERSION) + 1);
 	sns_reg_config = malloc(n_prefix + strlen(SNS_REG_CONFIG) + 1);
 	socinfo = malloc(n_prefix + strlen(SYSFS_SOCINFO) + 1);
+	backlight = malloc(n_prefix + strlen(SYSFS_BACKLIGHT) + 1);
+	display = malloc(n_prefix + strlen(SYSFS_DISPLAY) + 1);
 
 	dsp_libs = malloc(n_prefix + strlen(DSP_LIBS) + strlen(dsp) + 1);
 
@@ -168,6 +173,16 @@ struct hexagonfs_dirent *construct_root_dir(const char *prefix, const char *dsp,
 		strcat(socinfo, SYSFS_SOCINFO);
 	}
 
+	if (backlight != NULL) {
+		strcpy(backlight, prefix);
+		strcat(backlight, SYSFS_BACKLIGHT);
+	}
+
+	if (display != NULL) {
+		strcpy(display, prefix);
+		strcat(display, SYSFS_DISPLAY);
+	}
+
 	if (dsp_libs != NULL) {
 		strcpy(dsp_libs, prefix);
 		strcat(dsp_libs, DSP_LIBS);
@@ -216,7 +231,15 @@ struct hexagonfs_dirent *construct_root_dir(const char *prefix, const char *dsp,
 				)
 			),
 			persist_dir,
-			hfs_mkdir("sys", 1,
+			hfs_mkdir("sys", 2,
+				hfs_mkdir("class", 2,
+					hfs_mkdir("backlight", 1,
+						hfs_map_or_empty("panel0-backlight", backlight)
+					),
+					hfs_mkdir("drm", 1,
+						hfs_map_or_empty("card0-DSI-1", display)
+					)
+				),
 				hfs_mkdir("devices", 1,
 					hfs_map_or_empty("soc0", socinfo)
 				)
